# Copy to .env for local overrides. All vars are prefixed WEBHOOK_ per
# core/config.py's env_prefix.

WEBHOOK_ENVIRONMENT=local
WEBHOOK_LOG_LEVEL=INFO
WEBHOOK_LOG_JSON=false

WEBHOOK_OTEL_ENABLED=true
WEBHOOK_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
WEBHOOK_OTEL_TRACES_SAMPLE_RATIO=1.0

WEBHOOK_DATABASE_URL=postgresql+asyncpg://webhook:webhook@localhost:5432/webhook-delivery
WEBHOOK_REDIS_URL=redis://localhost:6379/0
WEBHOOK_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Secrets ---
#
# Optional locally; REQUIRED in staging/production, where the app refuses to
# start if they are missing, shorter than 32 characters, or still set to a
# development default. Never commit real values and never bake them into an
# image — in Kubernetes they come from the `webhook-backend-secrets` Secret
# referenced by the Deployment.
#
# Generate with: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET_ENCRYPTION_KEY=
WEBHOOK_API_KEY_PEPPER=
